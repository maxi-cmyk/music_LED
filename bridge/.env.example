# Copy to .env. Do not commit this file or share its values.
SPOTIFY_CLIENT_ID=replace-with-dashboard-client-id
SPOTIFY_CLIENT_SECRET=replace-with-dashboard-client-secret
MUSIC_LED_BRIDGE_KEY=replace-with-a-long-random-value
# Must exactly match the Spotify dashboard redirect URI.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback
