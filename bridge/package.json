{
  "name": "spotify-oled-bridge",
  "private": true,
  "version": "0.1.0",
  "description": "Local authenticated Spotify now-playing bridge for the ESP32 OLED display",
  "scripts": {
    "dev": "node src/index.js",
    "service:install": "node scripts/install-launch-agent.js",
